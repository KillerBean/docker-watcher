TELEGRAM_BOT_TOKEN=   # token do bot (@BotFather)
TELEGRAM_CHAT_ID=     # ID do chat/grupo destino
WATCHER_IGNORE=certbot  # containers ignorados, separados por vírgula
DISK_WARN_PERCENT=80  # % de uso para disparar alerta (default: 80)
DISK_CHECK_INTERVAL=300  # intervalo de checagem em segundos (default: 300)
DISK_PATHS=/  # paths a monitorar, separados por vírgula (default: /)
WATCHER_ALERTS_PER_MINUTE=30  # limite local de alertas Telegram (default: 30)
WATCHER_METRICS_INTERVAL=60  # intervalo dos contadores no log (default: 60)
RECONNECT_INITIAL_DELAY=1  # backoff inicial em segundos
RECONNECT_MAX_DELAY=60  # teto do backoff em segundos
RECONNECT_JITTER=0.2  # jitter proporcional entre 0 e 1
